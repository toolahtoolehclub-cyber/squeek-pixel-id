/// @dev PEMBAYARAN HANYA VIA PERMIT (EIP-2612). Pemain menandatangani permit
/// untuk JUMLAH EXACT harga item (deadline ~10 menit); kontrak memanggil
/// `permit()` lalu `transferFrom()`. TIDAK PERNAH ada unlimited approve /
/// `setApprovalForAll` di alur ini — allowance yang dibuat permit selalu
/// sebesar harga, dan langsung habis dipakai `transferFrom` dalam tx yang sama.
///
/// @dev SPLIT 0% burn / 70% owner / 30% prize pool, ditulis di kontrak:
/// setiap pembelian, 70% harga LANGSUNG dikirim ke `owner` dalam tx yang
/// sama, 30% mengendap di kontrak sebagai `prizePool`. Sisa pool di akhir
/// musim disapu ke `owner` (tujuan tetap, tidak bisa diubah) lewat `sweep()`,
/// yang baru bisa dipanggil setelah `seasonEnd + 7 days`, dan hanya sekali.
///
/// @dev GACHA (Kapsul Emas, 2 SQK/pull): pemain `commitCapsule()` dengan
/// permit 2 SQK, lalu Worker me-resolve dengan `dataHash` hamster dari round
/// yang sudah settled + signature EIP-712 dari `dataSigner`. Randomness =
/// `keccak256(dataHash, pullId, player) % 100` — BUKAN VRF (ditunda, lihat
/// Rancangan-v38). Hard pity: 19 hasil common berturut-turut memaksa pull
/// berikutnya minimal rare. Duplikat TIDAK menambah balance item; sebagai
/// gantinya event membawa `kejuCompensation` (25/50/100/250 Keju per tier)
/// yang dikreditkan Worker ke D1 — kontrak TIDAK memegang Keju.
///
/// @dev KEPEMILIKAN KOSMETIK DICATAT DI KONTRAK INI SAJA (mapping
/// `player => itemId => balance`), BUKAN ERC-1155 penuh. Alasan: permukaan
/// serang terkecil — tidak ada transfer, approval, operator, atau
/// `safeTransferFrom` yang bisa disalahgunakan; kosmetik terikat akun game
/// persis seperti item Keju di D1 (tidak bisa diperdagangkan). Bila suatu
/// hari kosmetik harus bisa dipindah-tangankan, deploy kontrak token baru
/// yang membaca balance di sini sebagai snapshot — kontrak ini tidak perlu
/// diubah.
///
/// @dev TIDAK ADA owner/admin/upgrade/proxy/withdraw sembarangan di kontrak
/// ini. Semua parameter (SQK, owner, dataSigner, seasonEnd) immutable dan
/// ditetapkan sekali di constructor. Satu-satunya aliran SQK keluar dari
/// kontrak adalah: (a) 70% tiap pembelian langsung ke `owner`, (b) `sweep()`
/// mengirim SELURUH `prizePool` ke `owner` setelah musim berakhir + jeda
/// 7 hari. Tidak ada fungsi lain yang memindahkan SQK.
///
/// @dev DOMAIN EIP-712 GACHA — KONVENSIONAL (beda dengan Batch 4):
///   { name: "Squeek Pixel Shop", version: "1",
///     chainId: 11155111 (Sepolia), verifyingContract: address(this) }
/// Worker menandatangani KHUSUS untuk kontrak ini, jadi signature gacha
/// tidak bisa dipakai ulang di kontrak lain. (Batch 4 memakai signer sebagai
/// verifyingContract karena Worker sudah menandatangani begitu sebelum
/// kontrak skor ada; di sini Worker menandatangani untuk kontrak ini sejak
/// awal, jadi dipakai cara konvensional.)
///
/// @dev DOMAIN PERMIT SQK (token, BUKAN kontrak ini) — dibaca langsung dari
/// chain Sepolia 2026-11-08: token 0xd78a3956cF63164d1Fa1C622ad3c66623162Fa1e,
/// name "Squeek", symbol "SQK", decimals 18, eip712Domain name "Squeek",
/// version "1", chainId 11155111, verifyingContract = alamat token sendiri.
/// Client HARUS menandatangani permit dengan domain name "Squeek" (bukan
/// "SQK"); permit yang ditandatangani dengan nama lain akan revert di token.
contract SqueekPixelShop {
    using ECDSA for bytes32;

    // ------------------------------------------------------------------------
    // Konstanta
    // ------------------------------------------------------------------------

    /// @notice Jeda setelah seasonEnd sebelum prize pool boleh disapu.
    uint256 public constant SWEEP_DELAY = 7 days;

    /// @notice Harga satu pull Kapsul Emas: 2 SQK (SQK 18 desimal).
    uint256 public constant CAPSULE_PRICE = 2 * 1e18;

    /// @notice Odds gacha (rand 0..99): 0..69 common, 70..91 rare,
    /// 92..98 epic, 99 legendary. Dipublikasi sebagai konstanta.
    uint256 public constant COMMON_MAX = 69;
    uint256 public constant RARE_MAX = 91;
    uint256 public constant EPIC_MAX = 98;

    /// @notice Hard pity: pityCounter >= 19 memaksa pull berikutnya rare+.
    uint256 public constant HARD_PITY = 19;

    /// @notice Kompensasi Keju untuk item duplikat, per tier
    /// [common, rare, epic, legendary]. Dikreditkan Worker ke D1, bukan kontrak.
    uint256 public constant COMP_COMMON = 25;
    uint256 public constant COMP_RARE = 50;
    uint256 public constant COMP_EPIC = 100;
    uint256 public constant COMP_LEGENDARY = 250;

    /// @notice Sepolia chain id.
    uint256 public constant CHAIN_ID = 11155111;

    /// @notice EIP-712 domain name kontrak ini (untuk signature gacha).
    string public constant EIP712_NAME = "Squeek Pixel Shop";

    /// @notice EIP-712 domain version kontrak ini.
    string public constant EIP712_VERSION = "1";

    /// @notice keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
    bytes32 public constant DOMAIN_TYPEHASH =
        keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");

    /// @notice keccak256("CapsuleResolve(address player,uint256 pullId,uint256 targetRound,bytes32 dataHash,uint256 deadline)")
    bytes32 public constant CAPSULE_TYPEHASH =
        keccak256("CapsuleResolve(address player,uint256 pullId,uint256 targetRound,bytes32 dataHash,uint256 deadline)");

    // ------------------------------------------------------------------------
    // Immutable
    // ------------------------------------------------------------------------

    /// @notice Token SQK (ERC-20 + EIP-2612 permit). Alamat Sepolia:
    /// 0xd78a3956cF63164d1Fa1C622ad3c66623162Fa1e.
    ISQKToken public immutable sqk;

    /// @notice Penerima 70% tiap pembelian + seluruh sisa prize pool saat sweep.
    address public immutable owner;

    /// @notice Alamat kunci Worker yang menandatangani resolve gacha.
    address public immutable dataSigner;

    /// @notice Akhir musim (epoch seconds). Sweep baru bisa setelah ini + 7 hari.
    uint256 public immutable seasonEnd;

    /// @notice Domain separator EIP-712 kontrak ini (verifyingContract == address(this)).
    bytes32 public immutable DOMAIN_SEPARATOR;

    // ------------------------------------------------------------------------
    // Storage
    // ------------------------------------------------------------------------

    /// @notice Harga katalog toko (SQK, 18 desimal). 0 = item tidak dijual.
    /// 1 "Skin Rare" 5 SQK, 2 "Efek Epic" 10 SQK, 3 "Bingkai Animasi" 15 SQK,
    /// 4 "Skin Epic" 20 SQK, 5 "Golden Wheel" 50 SQK, 6 "Skin Legendary" 100 SQK.
    mapping(uint256 => uint256) private _itemPrice;

    /// @notice Nama item katalog + hadiah gacha (101..104).
    mapping(uint256 => string) private _itemName;

    /// @notice Kepemilikan kosmetik: player => itemId => jumlah.
    /// @dev BUKAN ERC-1155 — sengaja, lihat NatSpec kontrak di atas.
    mapping(address => mapping(uint256 => uint256)) private _itemBalance;

    /// @notice Jumlah item yang tercatat (pembelian toko + hadiah gacha
    /// non-duplikat). Dipakai invariant test.
    uint256 public totalItemsGranted;

    /// @notice SQK yang mengendap di kontrak (30% tiap pembelian).
    /// Harus SELALU sama dengan saldo SQK kontrak.
    uint256 public prizePool;

    /// @notice Apakah prize pool sudah disapu.
    bool private _swept;

    /// @notice Pull kapsul berikutnya. Pull pertama ber-id 1.
    uint256 private _nextPullId = 1;

    /// @notice Jumlah hasil common berturut-turut per pemain (untuk hard pity).
    mapping(address => uint256) private _pityCounter;

    /// @notice Semua pull kapsul, keyed by pullId (mulai dari 1).
    mapping(uint256 => Pull) private _pulls;

    // ------------------------------------------------------------------------
    // Types
    // ------------------------------------------------------------------------

    /// @notice Satu pull Kapsul Emas yang sudah di-commit (belum tentu resolved).
    struct Pull {
        address player;
        uint256 targetRound;
        bool resolved;
    }

    /// @notice Rarity hasil gacha: 0 common, 1 rare, 2 epic, 3 legendary.
    /// @dev Disimpan sebagai uint8 di event agar client mudah membaca.
    enum Rarity {
        Common,
        Rare,
        Epic,
        Legendary
    }

    // ------------------------------------------------------------------------
    // Events
    // ------------------------------------------------------------------------

    /// @notice Emitted setiap pembelian item toko berhasil.
    event ItemPurchased(
        address indexed player,
        uint256 indexed itemId,
        uint256 price,
        uint256 ownerShare,
        uint256 poolShare
    );

    /// @notice Emitted setiap commit Kapsul Emas berhasil.
    event CapsuleCommitted(address indexed player, uint256 indexed pullId, uint256 targetRound);

    /// @notice Emitted setiap resolve kapsul berhasil.
    /// @param rarity 0 common, 1 rare, 2 epic, 3 legendary.
    /// @param duplicate true bila pemain sudah punya item itu (balance tidak
    ///   bertambah; `kejuCompensation` dikreditkan Worker ke D1).
    event CapsuleResolved(
        address indexed player,
        uint256 indexed pullId,
        uint256 targetRound,
        bytes32 dataHash,
        uint8 rarity,
        uint256 itemId,
        bool duplicate,
        uint256 kejuCompensation
    );

    /// @notice Emitted saat prize pool disapu ke owner.
    event PrizePoolSwept(address indexed owner, uint256 amount, uint256 seasonEnd);

    // ------------------------------------------------------------------------
    // Errors
    // ------------------------------------------------------------------------

    /// @notice Constructor menerima alamat nol.
    error ZeroAddress();

    /// @notice seasonEnd tidak di masa depan.
    error SeasonEndInPast(uint256 seasonEnd, uint256 nowTimestamp);

    /// @notice Item tidak ada di katalog toko (harga 0 / id di luar 1..6).
    error ItemNotFound(uint256 itemId);

    /// @notice Deadline (permit / resolve) sudah lewat.
    error DeadlineExpired(uint256 deadline, uint256 nowTimestamp);

    /// @notice Transfer SQK mengembalikan false.
    error TransferFailed();

    /// @notice Pull id tidak ada.
    error PullNotFound(uint256 pullId);

    /// @notice Pull sudah pernah di-resolve.
    error PullAlreadyResolved(uint256 pullId);

    /// @notice Pemanggil bukan pemilik pull.
    error NotPullOwner(address caller, address pullOwner);

    /// @notice Signature resolve tidak pulih ke `dataSigner`.
    error InvalidSignature(address recovered);

    /// @notice Sweep dipanggil sebelum seasonEnd + 7 hari.
    error SweepTooEarly(uint256 availableAt, uint256 nowTimestamp);

    /// @notice Prize pool sudah disapu; sweep hanya sekali.
    error AlreadySwept();

    // ------------------------------------------------------------------------
    // Constructor
    // ------------------------------------------------------------------------

    /// @notice Deploy toko + gacha dan kunci semua parameter selamanya.
    /// @param sqk_ Alamat token SQK (Sepolia).
    /// @param owner_ Penerima 70% + sisa prize pool.
    /// @param dataSigner_ Alamat kunci Worker untuk signature resolve gacha.
    /// @param seasonEnd_ Akhir musim (epoch seconds, harus di masa depan).
    /// @dev Tidak ada owner/admin yang dibuat. Semua immutable; rotasi kunci
    ///   atau musim baru = deploy kontrak baru.
    constructor(address sqk_, address owner_, address dataSigner_, uint256 seasonEnd_) {
        if (sqk_ == address(0) || owner_ == address(0) || dataSigner_ == address(0)) revert ZeroAddress();
        if (seasonEnd_ <= block.timestamp) revert SeasonEndInPast(seasonEnd_, block.timestamp);
        sqk = ISQKToken(sqk_);
        owner = owner_;
        dataSigner = dataSigner_;
        seasonEnd = seasonEnd_;

        DOMAIN_SEPARATOR = keccak256(
            abi.encode(
                DOMAIN_TYPEHASH,
                keccak256(bytes(EIP712_NAME)),
                keccak256(bytes(EIP712_VERSION)),
                CHAIN_ID,
                address(this)
            )
        );

        // Katalog toko (FROZEN — client v42 memakai id yang sama).
        _itemPrice[1] = 5 * 1e18;
        _itemName[1] = "Skin Rare";
        _itemPrice[2] = 10 * 1e18;
        _itemName[2] = "Efek Epic";
        _itemPrice[3] = 15 * 1e18;
        _itemName[3] = "Bingkai Animasi";
        _itemPrice[4] = 20 * 1e18;
        _itemName[4] = "Skin Epic";
        _itemPrice[5] = 50 * 1e18;
        _itemName[5] = "Golden Wheel";
        _itemPrice[6] = 100 * 1e18;
        _itemName[6] = "Skin Legendary";

        // Hadiah gacha (tidak dijual; harga 0). Nama tidak frozen.
        _itemName[101] = "Kapsul Common";
        _itemName[102] = "Kapsul Rare";
        _itemName[103] = "Kapsul Epic";
        _itemName[104] = "Kapsul Legendary";
    }

    // ------------------------------------------------------------------------
    // Toko — beli dengan permit
    // ------------------------------------------------------------------------

    /// @notice Beli satu item katalog dengan permit EIP-2612 jumlah exact.
    /// @param itemId Id item katalog (1..6).
    /// @param deadline Deadline permit (epoch seconds, ~10 menit dari sekarang).
    /// @param v Bagian v dari signature permit pemain.
    /// @param r Bagian r dari signature permit pemain.
    /// @param s Bagian s dari signature permit pemain.
    /// @dev Urutan: cek item & deadline -> permit exact harga -> transferFrom
    ///   -> catat state (balance item, prizePool) -> kirim 70% ke owner ->
    ///   event. State dicatat SEBELUM transfer ke owner. Permit yang salah /
    ///   kedaluwarsa revert di token; saldo/allowance kurang revert di
    ///   transferFrom. Tidak ada approve unlimited di mana pun.
    function buyWithPermit(uint256 itemId, uint256 deadline, uint8 v, bytes32 r, bytes32 s) external {
        uint256 price = _itemPrice[itemId];
        if (price == 0) revert ItemNotFound(itemId);
        if (block.timestamp > deadline) revert DeadlineExpired(deadline, block.timestamp);

        sqk.permit(msg.sender, address(this), price, deadline, v, r, s);
        if (!sqk.transferFrom(msg.sender, address(this), price)) revert TransferFailed();

        (uint256 ownerShare, uint256 poolShare) = splitFor(price);

        // Effects sebelum interaction terakhir (transfer ke owner).
        _itemBalance[msg.sender][itemId] += 1;
        totalItemsGranted += 1;
        prizePool += poolShare;

        if (!sqk.transfer(owner, ownerShare)) revert TransferFailed();

        emit ItemPurchased(msg.sender, itemId, price, ownerShare, poolShare);
    }

    // ------------------------------------------------------------------------
    // Gacha — commit + resolve
    // ------------------------------------------------------------------------

    /// @notice Commit satu pull Kapsul Emas (2 SQK) dengan permit jumlah exact.
    /// @param targetRound Round hamster yang ditarget (round yang sudah
    ///   settled saat resolve; Worker yang menentukan nilainya).
    /// @param deadline Deadline permit (epoch seconds, ~10 menit).
    /// @param v Bagian v dari signature permit pemain.
    /// @param r Bagian r dari signature permit pemain.
    /// @param s Bagian s dari signature permit pemain.
    /// @return pullId Id pull yang dibuat (mulai dari 1, naik berurutan).
    /// @dev Split 70/30 sama seperti pembelian toko.
    function commitCapsule(uint256 targetRound, uint256 deadline, uint8 v, bytes32 r, bytes32 s)
        external
        returns (uint256 pullId)
    {
        if (block.timestamp > deadline) revert DeadlineExpired(deadline, block.timestamp);

        sqk.permit(msg.sender, address(this), CAPSULE_PRICE, deadline, v, r, s);
        if (!sqk.transferFrom(msg.sender, address(this), CAPSULE_PRICE)) revert TransferFailed();

        (uint256 ownerShare, uint256 poolShare) = splitFor(CAPSULE_PRICE);

        pullId = _nextPullId;
        _nextPullId += 1;
        _pulls[pullId] = Pull({ player: msg.sender, targetRound: targetRound, resolved: false });
        prizePool += poolShare;

        if (!sqk.transfer(owner, ownerShare)) revert TransferFailed();

        emit CapsuleCommitted(msg.sender, pullId, targetRound);
    }

    /// @notice Resolve satu pull kapsul dengan dataHash round + signature Worker.
    /// @param pullId Id pull yang di-resolve.
    /// @param dataHash dataHash hamster dari round yang sudah settled.
    /// @param deadline Deadline signature resolve (epoch seconds, ~10 menit).
    /// @param signature Signature EIP-712 dari `dataSigner` atas struct
    ///   CapsuleResolve(player, pullId, targetRound, dataHash, deadline)
    ///   dengan domain kontrak ini.
    /// @dev Rarity dari rand = uint256(keccak256(abi.encode(dataHash, pullId,
    ///   player))) % 100. Hard pity: pityCounter >= 19 memaksa rand ke
    ///   70..91 (minimal rare). Pity naik tiap hasil common, reset 0 tiap
    ///   hasil rare/epic/legendary. Duplikat tidak menambah balance; event
    ///   membawa kejuCompensation untuk dikreditkan Worker ke D1.
    function resolveCapsule(uint256 pullId, bytes32 dataHash, uint256 deadline, bytes calldata signature) external {
        Pull storage pull = _pulls[pullId];
        if (pull.player == address(0)) revert PullNotFound(pullId);
        if (pull.resolved) revert PullAlreadyResolved(pullId);
        if (pull.player != msg.sender) revert NotPullOwner(msg.sender, pull.player);
        if (block.timestamp > deadline) revert DeadlineExpired(deadline, block.timestamp);

        address recovered = _recoverResolveSigner(pull.player, pullId, pull.targetRound, dataHash, deadline, signature);
        if (recovered != dataSigner) revert InvalidSignature(recovered);

        // Effects: tandai resolved dulu.
        pull.resolved = true;

        uint256 rand = uint256(keccak256(abi.encode(dataHash, pullId, pull.player))) % 100;
        if (_pityCounter[pull.player] >= HARD_PITY) {
            // Paksa minimal rare: 70 + (rand % 22) = 70..91.
            rand = 70 + (rand % 22);
        }

        uint8 rarity;
        uint256 itemId;
        uint256 kejuCompensation;
        if (rand <= COMMON_MAX) {
            rarity = uint8(Rarity.Common);
            itemId = 101;
            kejuCompensation = COMP_COMMON;
        } else if (rand <= RARE_MAX) {
            rarity = uint8(Rarity.Rare);
            itemId = 102;
            kejuCompensation = COMP_RARE;
        } else if (rand <= EPIC_MAX) {
            rarity = uint8(Rarity.Epic);
            itemId = 103;
            kejuCompensation = COMP_EPIC;
        } else {
            rarity = uint8(Rarity.Legendary);
            itemId = 104;
            kejuCompensation = COMP_LEGENDARY;
        }

        bool duplicate;
        if (_itemBalance[pull.player][itemId] > 0) {
            duplicate = true;
            // Balance TIDAK bertambah; kompensasi Keju ditangani Worker.
        } else {
            _itemBalance[pull.player][itemId] += 1;
            totalItemsGranted += 1;
        }

        if (rarity == uint8(Rarity.Common)) {
            _pityCounter[pull.player] += 1;
        } else {
            _pityCounter[pull.player] = 0;
        }

        emit CapsuleResolved(pull.player, pullId, pull.targetRound, dataHash, rarity, itemId, duplicate, kejuCompensation);
    }

    // ------------------------------------------------------------------------
    // Sweep prize pool
    // ------------------------------------------------------------------------

    /// @notice Kirim SELURUH prizePool ke `owner` (tujuan tetap).
    /// @dev Hanya setelah block.timestamp >= seasonEnd + 7 days; siapa pun
    ///   boleh memanggil; hanya sekali. Setelah sweep, prizePool = 0 dan
    ///   isSwept() = true. Bila pool 0, sweep tetap menandai swept (tidak ada
    ///   SQK yang bergerak).
    function sweep() external {
        if (_swept) revert AlreadySwept();
        if (block.timestamp < seasonEnd + SWEEP_DELAY) {
            revert SweepTooEarly(seasonEnd + SWEEP_DELAY, block.timestamp);
        }
        uint256 amount = prizePool;
        _swept = true;
        prizePool = 0;
        if (amount > 0) {
            if (!sqk.transfer(owner, amount)) revert TransferFailed();
        }
        emit PrizePoolSwept(owner, amount, seasonEnd);
    }

    // ------------------------------------------------------------------------
    // Views
    // ------------------------------------------------------------------------

    /// @notice Bagi `price` menjadi (ownerShare 70%, poolShare 30%).
    /// @dev ownerShare = price * 70 / 100 (pembulatan ke bawah); poolShare =
    ///   price - ownerShare, jadi keduanya SELALU berjumlah tepat `price`.
    ///   Untuk harga katalog (kelipatan 1 SQK = 1e18 wei) split EXACT.
    function splitFor(uint256 price) public pure returns (uint256 ownerShare, uint256 poolShare) {
        ownerShare = (price * 70) / 100;
        poolShare = price - ownerShare;
    }

    /// @notice Harga item katalog (SQK wei). 0 = tidak dijual (termasuk 101..104).
    function itemPrice(uint256 itemId) external view returns (uint256) {
        return _itemPrice[itemId];
    }

    /// @notice Nama item (katalog 1..6 + hadiah gacha 101..104).
    function itemName(uint256 itemId) external view returns (string memory) {
        return _itemName[itemId];
    }

    /// @notice Jumlah item `itemId` yang dimiliki `player`.
    function balanceOfItem(address player, uint256 itemId) external view returns (uint256) {
        return _itemBalance[player][itemId];
    }

    /// @notice Jumlah hasil common berturut-turut `player` (0..19).
    function pityCounter(address player) external view returns (uint256) {
        return _pityCounter[player];
    }

    /// @notice Data pull `pullId` (player, targetRound, resolved).
    function pulls(uint256 pullId) external view returns (Pull memory) {
        return _pulls[pullId];
    }

    /// @notice Id pull berikutnya (pull pertama = 1).
    function nextPullId() external view returns (uint256) {
        return _nextPullId;
    }

    /// @notice Apakah prize pool sudah disapu.
    function isSwept() external view returns (bool) {
        return _swept;
    }

    /// @notice Timestamp paling awal sweep bisa dipanggil (seasonEnd + 7 hari).
    function sweepAvailableAt() external view returns (uint256) {
        return seasonEnd + SWEEP_DELAY;
    }

    /// @notice Domain separator EIP-712 kontrak ini.
    function domainSeparator() external view returns (bytes32) {
        return DOMAIN_SEPARATOR;
    }

    // ------------------------------------------------------------------------
    // Internal
    // ------------------------------------------------------------------------

    /// @notice Pulihkan penandatangan resolve dari signature EIP-712.
    /// @dev Struct hash mengikuti urutan field CapsuleResolve; domain =
    ///   DOMAIN_SEPARATOR kontrak ini (verifyingContract == address(this)).
    ///   tryRecover dipakai agar signature cacat menghasilkan
    ///   InvalidSignature, bukan revert OZ yang generik.
    function _recoverResolveSigner(
        address player,
        uint256 pullId,
        uint256 targetRound,
        bytes32 dataHash,
        uint256 deadline,
        bytes calldata signature
    ) internal view returns (address) {
        bytes32 structHash = keccak256(
            abi.encode(CAPSULE_TYPEHASH, player, pullId, targetRound, dataHash, deadline)
        );
        bytes32 digest = MessageHashUtils.toTypedDataHash(DOMAIN_SEPARATOR, structHash);
        (address recovered, ECDSA.RecoverError err, ) = ECDSA.tryRecover(digest, signature);
        if (err != ECDSA.RecoverError.NoError) return address(0);
        return recovered;
    }
}

/// @notice Token SQK: ERC-20 biasa + permit EIP-2612 (OZ v5).
/// @dev Satu handle untuk kedua interface agar kontrak memakai satu alamat.
interface ISQKToken is IERC20, IERC20Permit {}
